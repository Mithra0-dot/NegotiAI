# Copy this file to .env and fill in your key.
# .env is gitignored (see repo root .gitignore) — never commit real keys.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Set to true to skip the real Anthropic call and use canned,
# tactic-appropriate replies instead — no API key/credits needed. Good
# for demos or repeated local testing of the phase/tactic/signal flow.
MOCK_LLM=false

# Local dev default matches repo-root docker-compose.yml — start it with
# `docker compose up -d`. Override for a different Postgres (e.g. Render
# in production). Must be Postgres, not SQLite.
DATABASE_URL=postgresql+psycopg://negotiai:negotiai@localhost:5432/negotiai
